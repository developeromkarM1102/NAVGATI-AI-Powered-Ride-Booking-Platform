# Server port for the backend API and Socket.IO server
PORT=your_port

# Secret key used to sign and verify JWT authentication tokens
JWT_SECRET=your_jwt_secret

# MongoDB connection string for connecting the application to the database
MONGO_URI=your_mongodb_connection_string

# API key used to access Google Gemini AI services
GEMINI_API_KEY=your_gemini_api_key

# API key used to access Geoapify location and mapping services
GEOAPIFY_API_KEY=your_geoapify_api_key

# Google OAuth Client ID for Google authentication
GOOGLE_CLIENT_ID=your_google_client_id

# Google OAuth Client Secret for Google authentication
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google OAuth callback URL where Google redirects users after authentication
GOOGLE_CALLBACK_URL=your_google_callback_url

# Frontend URL allowed to communicate with the backend and Socket.IO server
FRONTEND_URL=your_frontend-url